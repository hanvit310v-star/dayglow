{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git clone --depth 1 -b 3.50.1 https://github.com/flutter/flutter.git .flutter-sdk && .flutter-sdk/bin/flutter config --no-analytics && cd app && ../.flutter-sdk/bin/flutter pub get",
  "buildCommand": "cd app && ../.flutter-sdk/bin/flutter build web --release",
  "outputDirectory": "app/build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
      ]
    },
    {
      "source": "/(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
